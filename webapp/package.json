{
  "name": "cancerin-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CANCERIN potency-score predictor \u2014 fully static, runs entirely in the browser",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "dev": "npm run sync && vite",

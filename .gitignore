# NOTE: the previous .gitignore contained a bare `lib/` (inherited from a Python
# template), which silently excluded lib/ — the CDK 1.4.6 and PaDEL jars. Those
# are required to build the fingerprint engine and must stay tracked. Do not
# reintroduce a bare `lib/` rule.

# ---- build output ----------------------------------------------------------
# engine/prebuilt/ is deliberately NOT ignored: it holds the compiled engine so
# the app can be built with Node alone, without a JDK, Maven or lib/.
engine/target/
webapp/dist/
webapp/dist-standalone/
webapp/node_modules/

# Copied into the webapp by webapp/scripts/sync-assets.mjs
webapp/public/engine/
webapp/public/data/
webapp/src/lib/scoring.generated.js

# Verification screenshots
webapp/shot-*.png

# ---- generated data --------------------------------------------------------
# data/ is rebuilt by tools/build-data.mjs from cancerin-fingerprint + ids.cpk.
# data/column-order.json and data/probes* are NOT ignored: they needed PubChem
# access and a PaDEL run to produce, so they are tracked deliberately.
data/background.bin
data/background-raw.bin
data/annotations.json

# ---- legacy run artifacts --------------------------------------------------
cancerin_out
padel_test.csv
tc1
tc0
queryfp

# ---- local tooling ---------------------------------------------------------
.claude/

# ---- editor / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.~lock.*#
*.log
